{
  "name": "markdown-editor",
  "version": "1.2.1",
  "description": "A modern, interactive markdown editor with live preview, syntax highlighting, and export capabilities",
  "main": "index.html",
  "scripts": {
    "start": "open index.html",
    "serve": "npx http-server -p 8080",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "keywords": [
    "markdown",
    "editor",
    "live-preview",
    "syntax-highlighting",
    "web-app",
    "wysiwyg",
    "rich-text"
  ],
  "author": "Emrullah Celik <https://www.emrullahcelik.com/>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Emrullah007/markdown-editor.git"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "*.js",
      "!jest.config.js"
    ],
    "coverageDirectory": "coverage",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "dependencies": {

    "marked": "^11.1.1",
    "turndown": "^7.1.2",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
